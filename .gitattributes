/mvnw text eol=lf

# homecrew:standards:gitattributes:start
# Git hooks and Unix shell scripts MUST use LF on every platform.
.githooks/** text eol=lf
*.sh        text eol=lf

# Spotless-managed/project text files MUST use LF on every platform.
.editorconfig text eol=lf
*.java        text eol=lf
*.xml         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.properties  text eol=lf
*.json        text eol=lf
*.md          text eol=lf

# Normalise text in the repo, let git decide what is binary.
* text=auto

# Windows batch files genuinely need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# homecrew:standards:gitattributes:end